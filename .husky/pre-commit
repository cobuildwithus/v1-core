#!/bin/sh
set -e

staged_files="$(git diff --cached --name-only)"

docs_related_staged() {
  printf '%s\n' "$staged_files" | grep -Eq '^(ARCHITECTURE\.md|agent-docs/|\.husky/pre-commit$|scripts/(check-agent-docs-drift|doc-gardening)\.sh$|\.github/workflows/doc-gardening\.yml$)'
}

solidity_staged() {
  printf '%s\n' "$staged_files" | grep -Eq '^src/.*\.sol$'
}

if docs_related_staged; then
  bash scripts/doc-gardening.sh
  git add agent-docs/generated/doc-inventory.md agent-docs/generated/doc-gardening-report.md
fi

if solidity_staged; then
  pnpm -s prettier:write
fi

printf '%s\n' "$staged_files" | while IFS= read -r file; do
  [ -z "$file" ] && continue
  if [ -e "$file" ]; then
    git add -- "$file"
  else
    git rm --cached --ignore-unmatch -- "$file" >/dev/null 2>&1 || true
  fi
done
